#### App identity (inlined into the client bundle at build time)
NEXT_PUBLIC_APP_NAME=LobeHub
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Sender address for Cloudflare Email Routing. Must be on a zone with Email
# Routing enabled, otherwise outbound mail degrades to a console log.
NEXT_PUBLIC_APP_EMAIL=noreply@yourdomain.com
NEXT_PUBLIC_APP_DESCRIPTION=

#### Auth
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical origin. Optional: the auth stack resolves the base URL from the
# request against the allowlist in lib/auth/hosts.ts, so a deployment reachable
# on several hostnames keeps each visitor on the one they arrived at.
BETTER_AUTH_URL=
# Comma-separated extras for that allowlist, when this app is served from a
# hostname the defaults do not cover (a custom domain, a staging host).
#   BETTER_AUTH_ALLOWED_HOSTS=chat.example.com,*.staging.example.com
BETTER_AUTH_ALLOWED_HOSTS=
BETTER_AUTH_TRUSTED_ORIGINS=
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:   https://<your-host>/api/auth/callback/google
# Authorized JavaScript origin (One Tap): https://<your-host>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only needed to have One Tap prompt before /api/auth/providers has
# answered. The client id is served at runtime, so this can stay empty.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional additional OAuth providers. Both halves of a pair are required
# before the provider is registered or its button rendered.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

#### Billing (optional — the only non-Cloudflare dependency)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids the plans in lib/payments/plans.ts map to, and the Payment Links the
# upgrade card sends people to. Left empty, the plans render but cannot be bought.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_LINK_STARTER=
NEXT_PUBLIC_STRIPE_LINK_PRO=

#### Cloudflare — only needed for `drizzle-kit studio` and CI.
# Runtime data access goes through the D1 binding, not these values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Everything else is a Worker secret, set with:
#   bunx wrangler secret put BETTER_AUTH_SECRET
#   bunx wrangler secret put GOOGLE_CLIENT_SECRET
#   bunx wrangler secret put STRIPE_SECRET_KEY
