#### App identity (inlined into the client bundle at build time)
NEXT_PUBLIC_APP_NAME=LobeHub
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Sender address for Cloudflare Email Routing. Must be on a zone with Email
# Routing enabled, otherwise outbound mail degrades to a console log.
NEXT_PUBLIC_APP_EMAIL=noreply@yourdomain.com
NEXT_PUBLIC_APP_DESCRIPTION=

#### Auth
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#### Billing (optional — the only non-Cloudflare dependency)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

#### Cloudflare — only needed for `drizzle-kit studio` and CI.
# Runtime data access goes through the D1 binding, not these values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Everything else is a Worker secret, set with:
#   bunx wrangler secret put BETTER_AUTH_SECRET
#   bunx wrangler secret put GOOGLE_CLIENT_SECRET
#   bunx wrangler secret put STRIPE_SECRET_KEY
