{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lobehub-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],

  // The assets directory is supplied by @cloudflare/vite-plugin at build time,
  // so only the binding is declared here.
  "assets": {
    "binding": "ASSETS",
  },

  // Cloudflare Images — backs the /_next/image optimization endpoint.
  "images": {
    "binding": "IMAGES",
  },

  // ---------------------------------------------------------------------
  // The ids below name resources in this project's own Cloudflare account. A
  // resource id is not a credential — it does nothing without an API token —
  // so it is committed, the way Wrangler configs normally are. To build the
  // same app against a different account, override them at build time with
  // CLOUDFLARE_D1_DATABASE_ID, CLOUDFLARE_KV_VINEXT_CACHE_ID and
  // CLOUDFLARE_KV_APP_CACHE_ID — see scripts/resolve-wrangler-config.mjs.
  // ---------------------------------------------------------------------

  // ---------------------------------------------------------------------
  // D1 — the only datastore, created with:
  //   bunx wrangler d1 create lobehub
  //
  // Reads go through the Sessions API (lib/db/d1-session.ts), the same
  // architecture QwkSearch uses, so enabling read replication on this database
  // is a dashboard switch with no code change:
  //   bunx wrangler d1 read-replication enable lobehub
  // Until then the Sessions API is a no-op and every query hits the primary.
  // ---------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lobehub",
      "database_id": "059ea054-f709-4b4b-bb6e-dc25dc841ed5",
      "migrations_dir": "migrations",
    },
  ],

  // ---------------------------------------------------------------------
  // KV — VINEXT_CACHE backs ISR/fragment caching, APP_CACHE backs rate
  // limits and short-lived application caches. They are two separate
  // namespaces, created with:
  //   bunx wrangler kv namespace create VINEXT_CACHE
  //   bunx wrangler kv namespace create APP_CACHE
  // ---------------------------------------------------------------------
  "kv_namespaces": [
    {
      "binding": "VINEXT_CACHE",
      "id": "cbaa860dd2894dc9ae496f290cc60d3d",
    },
    {
      "binding": "APP_CACHE",
      "id": "7ca5e606272b4de5afcd5ee466d2cd34",
    },
  ],

  // R2 — user uploads and generated artifacts.
  //   bunx wrangler r2 bucket create lobehub-files
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lobehub-files",
    },
  ],

  // Workers AI — every chat completion and embedding in the app.
  "ai": {
    "binding": "AI",
  },

  // Cloudflare Email Routing — the only outbound mail path (magic links,
  // verification, team invitations). Requires Email Routing enabled on the
  // zone. Email Routing delivers to verified destination addresses; drop this
  // block if the account has no Email Routing zone and mail will degrade to a
  // console log instead of failing requests.
  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],

  // Vectorize — semantic search over messages. Uncomment after creating the
  // index with a dimension matching EMBEDDING_DIMENSIONS in lib/ai/models.ts:
  //   bunx wrangler vectorize create lobehub-memory --dimensions=768 --metric=cosine
  // "vectorize": [
  //   {
  //     "binding": "VECTORIZE",
  //     "index_name": "lobehub-memory",
  //   },
  // ],

  "vars": {
    "APP_NAME": "LobeHub",

    // How D1 sessions start, so read replication can be tuned — or rolled
    // back — from the dashboard without a redeploy. See lib/db/d1-session.ts.
    //   auto (default)  resume from the client's bookmark, else primary for
    //                   writes and any replica for reads
    //   primary         always start on the primary
    //   unconstrained   always start anywhere (lowest latency, weakest freshness)
    //   off             bypass the Sessions API entirely
    // `/api/auth/*` always starts on the primary regardless, except under `off`.
    "D1_SESSION_MODE": "auto",
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
