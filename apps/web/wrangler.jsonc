{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lobehub-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],

  // The assets directory is supplied by @cloudflare/vite-plugin at build time,
  // so only the binding is declared here.
  "assets": {
    "binding": "ASSETS",
  },

  // Cloudflare Images — backs the /_next/image optimization endpoint.
  "images": {
    "binding": "IMAGES",
  },

  // ---------------------------------------------------------------------
  // The REPLACE_WITH_… ids below are account-specific. Fill them in for local
  // work, or leave them and let CI supply them as build environment variables
  // (CLOUDFLARE_D1_DATABASE_ID, CLOUDFLARE_KV_VINEXT_CACHE_ID,
  // CLOUDFLARE_KV_APP_CACHE_ID) — see scripts/resolve-wrangler-config.mjs.
  // ---------------------------------------------------------------------

  // ---------------------------------------------------------------------
  // D1 — the only datastore. Create it with:
  //   bunx wrangler d1 create lobehub
  // then paste the returned database_id below.
  // ---------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lobehub",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],

  // ---------------------------------------------------------------------
  // KV — VINEXT_CACHE backs ISR/fragment caching, APP_CACHE backs rate
  // limits and short-lived application caches. They are two separate
  // namespaces; create both and paste the two distinct ids:
  //   bunx wrangler kv namespace create VINEXT_CACHE
  //   bunx wrangler kv namespace create APP_CACHE
  // ---------------------------------------------------------------------
  "kv_namespaces": [
    {
      "binding": "VINEXT_CACHE",
      "id": "REPLACE_WITH_YOUR_VINEXT_CACHE_KV_ID",
    },
    {
      "binding": "APP_CACHE",
      "id": "REPLACE_WITH_YOUR_APP_CACHE_KV_ID",
    },
  ],

  // R2 — user uploads and generated artifacts.
  //   bunx wrangler r2 bucket create lobehub-files
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lobehub-files",
    },
  ],

  // Workers AI — every chat completion and embedding in the app.
  "ai": {
    "binding": "AI",
  },

  // Cloudflare Email Routing — the only outbound mail path (magic links,
  // verification, team invitations). Requires Email Routing enabled on the
  // zone. Email Routing delivers to verified destination addresses; drop this
  // block if the account has no Email Routing zone and mail will degrade to a
  // console log instead of failing requests.
  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],

  // Vectorize — semantic search over messages. Uncomment after creating the
  // index with a dimension matching EMBEDDING_DIMENSIONS in lib/ai/models.ts:
  //   bunx wrangler vectorize create lobehub-memory --dimensions=768 --metric=cosine
  // "vectorize": [
  //   {
  //     "binding": "VECTORIZE",
  //     "index_name": "lobehub-memory",
  //   },
  // ],

  "vars": {
    "APP_NAME": "LobeHub",
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
