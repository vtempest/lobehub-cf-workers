{
  "name": "@lobehub/web",
  "version": "0.1.0",
  "private": true,
  "description": "LobeHub web app — Next.js App Router on Cloudflare Workers (D1, R2, KV, Workers AI, Email Routing)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vinext build",
    "cf:typegen": "wrangler types --path types/worker-configuration.d.ts",
    "check": "bun run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply lobehub --remote",
    "db:migrate:local": "wrangler d1 migrations apply lobehub --local",
    "db:studio": "drizzle-kit studio",
    "deploy": "vinext build && wrangler deploy",
    "dev": "vinext dev",
    "docs:generate": "fumadocs-mdx",
    "postinstall": "fumadocs-mdx",
    "preview": "vinext build && wrangler dev",
    "typecheck": "tsc --noEmit"
  },
